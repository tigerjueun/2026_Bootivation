#include <Servo.h>
#include <SoftwareSerial.h>
constexpr uint8_t SERVO_PIN=9,BT_RX_PIN=10,BT_TX_PIN=11,LED_BLUE_PIN=3,LED_RED_PIN=4,LED_GREEN_PIN=5;constexpr int ANGLE_A=85,ANGLE_B=45,ANGLE_C=0,ANGLE_HOME=150;constexpr size_t N=48;Servo s;SoftwareSerial bt(BT_RX_PIN,BT_TX_PIN);char ub[N],bb[N];size_t ul=0,bl=0;const char*ss="HOME";const char*ls="OFF";
void led(bool b,bool r,bool g,const char*n){digitalWrite(LED_BLUE_PIN,b);digitalWrite(LED_RED_PIN,r);digitalWrite(LED_GREEN_PIN,g);ls=n;}void servo(int a,const char*n){s.write(constrain(a,0,180));ss=n;}void ack(Stream&o,const char*c){o.print("ACK:");o.println(c);}void status(Stream&o){o.print("STATUS:SERVO=");o.print(ss);o.print(",LED=");o.println(ls);}void upper(char*t){for(size_t i=0;t[i];i++)if(t[i]>='a'&&t[i]<='z')t[i]-='a'-'A';}
void handle(const char*r,Stream&reply){char c[N];strncpy(c,r,N-1);c[N-1]=0;upper(c);if(!strcmp(c,"PING")){reply.println("PONG");return;}if(!strcmp(c,"GET_STATUS")){ack(reply,"GET_STATUS");status(reply);return;}if(!strcmp(c,"SERVO:A")||!strcmp(c,"A")){servo(ANGLE_A,"A");ack(reply,"SERVO:A");return;}if(!strcmp(c,"SERVO:B")||!strcmp(c,"B")){servo(ANGLE_B,"B");ack(reply,"SERVO:B");return;}if(!strcmp(c,"SERVO:C")||!strcmp(c,"C")){servo(ANGLE_C,"C");ack(reply,"SERVO:C");return;}if(!strcmp(c,"SERVO:HOME")||!strcmp(c,"HOME")){servo(ANGLE_HOME,"HOME");ack(reply,"SERVO:HOME");return;}if(!strcmp(c,"LED:BLUE")){led(1,0,0,"BLUE");ack(reply,"LED:BLUE");return;}if(!strcmp(c,"LED:RED")){led(0,1,0,"RED");ack(reply,"LED:RED");return;}if(!strcmp(c,"LED:GREEN")){led(0,0,1,"GREEN");ack(reply,"LED:GREEN");return;}if(!strcmp(c,"LED:OFF")){led(0,0,0,"OFF");ack(reply,"LED:OFF");return;}if(!strcmp(c,"RESET")){servo(ANGLE_HOME,"HOME");led(0,0,0,"OFF");ack(reply,"RESET");status(reply);return;}reply.println("ERROR:UNKNOWN_CMD");}
void input(Stream&i,Stream&r,char*b,size_t&l){while(i.available()){char c=i.read();if(c=='\r')continue;if(c=='\n'){if(l){b[l]=0;handle(b,r);l=0;}continue;}if(l<N-1)b[l++]=c;else l=0;}}
void setup(){pinMode(LED_BLUE_PIN,OUTPUT);pinMode(LED_RED_PIN,OUTPUT);pinMode(LED_GREEN_PIN,OUTPUT);led(0,0,0,"OFF");s.attach(SERVO_PIN);servo(ANGLE_HOME,"HOME");Serial.begin(9600);bt.begin(9600);bt.listen();delay(500);Serial.println("FW:BOOTIVATION_RIDER_V1");Serial.println("RIDER_READY");}
void loop(){input(Serial,Serial,ub,ul);bt.listen();input(bt,Serial,bb,bl);}
